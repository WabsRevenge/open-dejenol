<Project Sdk="Microsoft.NET.Sdk">

  <!-- The mod API (docs/MODDING.md): what a mod references, and the loader the game runs. No
       Avalonia here, so the loader and every hook can be exercised headless by Mordor.Tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mordor.Core\Mordor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 2.4.3, the latest 2.x: its MonoMod patches on the .NET 10 runtime, which 2.3.6 refuses ("CoreCLR version 10 is not supported") -->
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
  </ItemGroup>

</Project>
