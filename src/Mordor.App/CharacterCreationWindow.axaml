<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Mordor.App"
        x:Class="Mordor.App.CharacterCreationWindow"
        Title="Create Character" SizeToContent="WidthAndHeight" CanResize="False"
        app:UiFonts.Font="frmCreateChar"
        WindowStartupLocation="CenterScreen"
        >
    <DockPanel Margin="10">
        <!-- the original's bottom row of buttons -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,10,*,10,*" Margin="0,6,0,0">
            <Button Grid.Column="0" x:Name="CreateBtn" Content="_Save Character" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Padding="8" Background="{x:Static app:FixedColour.GoButton}" Click="OnCreate"/>
            <Button Grid.Column="2" x:Name="TutorialBtn" Content="_Tutorial" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Padding="8" Click="OnTutorial"/>
            <Button Grid.Column="4" x:Name="ExitBtn" Content="_Exit" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Padding="8" Click="OnExit"/>
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" x:Name="ErrorText" Foreground="{x:Static app:FixedColour.Refusal}" TextWrapping="Wrap" Margin="0,4,0,0"/>

        <Grid ColumnDefinitions="260,12,Auto,12,180">

            <!-- who you are -->
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Character Name" FontWeight="Bold"/>
                <!-- txtName in the lists' pale yellow, as the original's; it keeps it under the pointer and with the
                     keyboard, as every text box with a ground of its own does (ThemeSelection) -->
                <TextBox x:Name="NameBox" Background="{x:Static app:Palette.List}" Foreground="{x:Static app:Palette.Text}" CaretBrush="{x:Static app:Palette.Text}"/>

                <TextBlock Text="Race" FontWeight="Bold" Margin="0,10,0,0"/>
                <ComboBox x:Name="RaceBox" HorizontalAlignment="Stretch" SelectionChanged="OnRaceChanged"/>

                <TextBlock Text="Sex" FontWeight="Bold" Margin="0,10,0,0"/>
                <ComboBox x:Name="SexBox" HorizontalAlignment="Stretch"/>

                <TextBlock Text="Alignment" FontWeight="Bold" Margin="0,10,0,0"/>
                <ComboBox x:Name="AlignBox" HorizontalAlignment="Stretch" SelectionChanged="OnAlignChanged"/>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                    <Button x:Name="RaceStatsBtn" Content="Race Stats" Click="OnRaceStats"/>
                    <Button x:Name="GuildStatsBtn" Content="Guild Stats" Click="OnGuildStats"/>
                </StackPanel>
            </StackPanel>

            <!-- the six statistics -->
            <!-- its heading above the box, as the original's and as Guilds Allowed's, so the two boxes line up -->
            <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Stats" FontWeight="Bold" Margin="0,0,0,4"/>
            <Border x:Name="StatsBox" BorderBrush="{x:Static app:FixedColour.CreationFrame}" BorderThickness="1" Padding="10,6">
                <StackPanel Spacing="6">
                    <StackPanel x:Name="StatRows" Spacing="6"/>
                    <!-- the points left in a small field, the words beside it, as the original's form has them -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" HorizontalAlignment="Center">
                        <Border x:Name="PoolBox" Background="{x:Static app:Palette.Field}" BorderBrush="{x:Static app:Palette.Shadow}"
                                BorderThickness="1" MinWidth="36" Padding="4,1">
                            <TextBlock x:Name="PoolText" TextAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Stat Points Left" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            </DockPanel>

            <!-- which guilds would take you -->
            <!-- as tall as the stats beside it, not a height of its own -->
            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Text="Guilds Allowed" FontWeight="Bold" Margin="0,0,0,4"/>
                <Border x:Name="GuildsBox" BorderBrush="{x:Static app:FixedColour.CreationFrame}" BorderThickness="1" Background="{x:Static app:FixedColour.Win31Grey}" Padding="6,4">
                    <StackPanel x:Name="GuildRows" Spacing="2"/>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
