<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The test suites (selfcheck, mods, citations): the checks that assert. Run by tools/check.sh and,
    under `dotnet test`, by Mordor.Tests.Runner. The probes that only print are in Mordor.Tools.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mordor.Core\Mordor.Core.csproj" />
    <ProjectReference Include="..\..\src\Mordor.Modding\Mordor.Modding.csproj" />
  </ItemGroup>

  <!-- the bundled mods beside the suites too, so the mods suite loads the real QoL build; the
       iCloud Saves mod on every system, though only a macOS build ships it (ShipMods.targets) -->
  <PropertyGroup>
    <ShipICloudSaves>true</ShipICloudSaves>
  </PropertyGroup>
  <Import Project="..\..\src\Mods\ShipMods.targets" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
